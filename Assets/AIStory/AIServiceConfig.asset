  - "\u53E4\u5E0C\u814A\uFF0C\u4E9A\u6D32\u5C0F\u4F19\u5B50\u5149\u7740\u8180\u5B50\u52B3\u52A8\u5728\u679C\u56ED\u52B3\u52A8"
  - "\u53E4\u5E0C\u814A\uFF0C\u4E9A\u6D32\u5C0F\u4F19\u5B50\u5149\u7740\u8180\u5B50\u8D64\u811A\u5728\u5BAB\u6BBF\u7684\u5BB4\u4F1A\u4E0A\u52B3\u52A8"
  - "\u76DB\u590F\u96C5\u5178\u795E\u5E99\uFF0C\u4E00\u4E2A20\u5C81\u7684\u5341\u5206\u4FCA\u7F8E\u800C\u5065\u58EE\u7684\u4E9A\u6D32\uFF08\u504F\u4E2D\u56FD\u8138\uFF09\u6218\u58EB\uFF08\u8D64\u811A\uFF0C\u6301\u5251\uFF0C\u5149\u7740\u8180\u5B50\uFF0C\u77ED\u88D9\u7532\uFF0C\u5BF8\u5934\u53D1\u578B\uFF09\u6311\u6218\u90AA\u6076\u7684\u9B54\u6218\u58EB(\u53E4\u94DC\u8272\u76AE\u80A4\uFF0C\u7A7F\u76D4\u7532\uFF0C\u7565\u80D6\uFF09\uFF0C\u6218\u58EB\u521A\u4E3E\u8D77\u5251\u51B2\u5411\u9B54\u6218\u58EB\uFF0C\u5C31\u88AB\u9B54\u6218\u58EB\u4EE5\u9B54\u6CD5\u593A\u53D6\u624B\u4E2D\u6B66\u5668\uFF0C\u62AC\u5230\u534A\u7A7A\uFF0C\u8EAB\u4E0A\u6240\u6709\u94E0\u7532\u88AB\u9B54\u6CD5\u70B8\u788E\uFF0C\u6D51\u8EAB\u5927\u6C57\u3002\u7136\u540E\u6218\u58EB\u7684\u624B\u8155\u548C\u811A\u8155\u4E0A\u88AB\u6234\u4E0A\u91D1\u956F\u3002\u753B\u9762\u4E00\u8F6C\uFF0C\u6218\u58EB\u5DF2\u7ECF\u6210\u4E86\u9B54\u6218\u58EB\u5728\u5BAB\u6BBF\u91CC\u7684\u4F8D\u8005\uFF0C\u624B\u811A\u4ECD\u6234\u7740\u91D1\u73AF\uFF0C\u4F3A\u5019\u7740\u9B54\u6218\u58EB"
